<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
	<f:entry title="${%TestMu AI Credentials}" field="credentialsId">
		<c:select />
	</f:entry>
	<f:entry title="${%Objective}" field="objective">
		<f:textarea />
	</f:entry>
	<f:entry title="${%Start URL}" field="url">
		<f:textbox />
	</f:entry>
	<f:entry title="${%Test files}" field="testFiles">
		<f:textbox />
	</f:entry>
	<f:entry title="${%Run on HyperExecute}" field="remote">
		<f:checkbox />
	</f:entry>
	<f:advanced>
		<f:entry title="${%Timeout (seconds)}" field="timeout">
			<f:number default="300" min="1" />
		</f:entry>
		<f:entry title="${%Parallel workers}" field="parallel">
			<f:number default="1" min="1" />
		</f:entry>
		<f:entry title="${%Stop after the first failure}" field="failFast">
			<f:checkbox />
		</f:entry>
		<f:entry title="${%Install Chrome}" field="installChrome">
			<f:checkbox default="true" />
		</f:entry>
		<f:entry title="${%Kane CLI version}" field="kaneVersion">
			<f:textbox default="latest" />
		</f:entry>
		<f:entry title="${%Extra arguments}" field="extraArgs">
			<f:textbox />
		</f:entry>
		<f:entry title="${%Archive the evidence pack and logs}" field="archiveResults">
			<f:checkbox default="true" />
		</f:entry>
	</f:advanced>
</j:jelly>
